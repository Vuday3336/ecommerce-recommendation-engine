node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- Infra / logs ------------------------------------------------------------
logs/
*.log
pgdata/
redisdata/
grafana-data/

# --- Editors / OS ------------------------------------------------------------
.idea/

# VS Code: the run configurations are part of the project, not personal
# preference - "which file do I run first" should be answerable from the Run
# panel rather than from a README. Personal per-user state is still ignored.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini
ml/artifacts.rejected/
ml/artifacts.previous/
ml/artifacts.staging/
retrain-outcome.json

# Local PostgreSQL data directory (scripts/local_postgres.py)
.pgdata/
.pgpass_init

# --- Local MLflow backing store ----------------------------------------------
# The tracking store is per-developer state, not source. Runs are reproduced by
# re-running `ml/pipelines/train.py --mlflow`, which recreates it.
ml/mlflow.db
ml/mlflow.db-journal

