# Copy to .env and fill in. Never commit .env.
# Every key here is read through a typed settings object; nothing is hardcoded.

# --- Application -------------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_NAME=recommendation-platform
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_HASH_SCHEME=argon2

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EVENTS_PER_MINUTE=600
RATE_LIMIT_RECOMMENDATIONS_PER_MINUTE=120

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recommendations
POSTGRES_USER=recsys
POSTGRES_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_HOME_SECONDS=900
CACHE_TTL_SIMILAR_SECONDS=21600
CACHE_TTL_TRENDING_SECONDS=300

# --- MLflow ------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=recommendation-engine
MLFLOW_REGISTERED_MODEL_NAME=recsys-ranker
MODEL_STAGE=Production

# --- Recommendation engine ---------------------------------------------------
CANDIDATE_POOL_SIZE=300
RECOMMENDATIONS_PER_SECTION=12
ENABLE_ML_RANKER=true
ENABLE_MMR_DIVERSITY=true
MMR_LAMBDA=0.7
MAX_ITEMS_PER_CATEGORY=4
EXPLORATION_BUDGET=0.05

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Drift / retraining ------------------------------------------------------
DRIFT_PSI_WARN=0.10
DRIFT_PSI_ALERT=0.25
DRIFT_KS_PVALUE_ALERT=0.01
RETRAIN_SCHEDULE_CRON=0 3 * * *
PROMOTION_MIN_NDCG_UPLIFT=0.01
PROMOTION_MAX_COVERAGE_DROP=0.05

# --- Synthetic data generation ----------------------------------------------
SEED=42
N_USERS=10000
N_PRODUCTS=5000
N_EVENTS=250000
SIMULATION_DAYS=180

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
